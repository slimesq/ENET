{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ENET: build Debug",
      "type": "shell",
      "command": "bash",
      "args": ["${workspaceFolder}/scripts/build-linux.sh"],
      "windows": {
        "command": "powershell.exe",
        "args": [
          "-NoProfile",
          "-ExecutionPolicy",
          "Bypass",
          "-File",
          "${workspaceFolder}\\scripts\\build-remote.ps1"
        ]
      },
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
